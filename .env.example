# ─── Database ──────────────────────────────────────────────────────────────
# asyncpg connection string used by the FastAPI backend
DB_URL=postgresql+asyncpg://tradeflux:tradeflux@localhost:5432/tradeflux

# ─── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=tradeflux.ticks

# ─── FastAPI ───────────────────────────────────────────────────────────────
ALLOW_CORS=true

# ─── Market data provider ──────────────────────────────────────────────────
# "mock" uses the built-in random-walk tick producer
# "alpaca" streams real IEX trades from Alpaca Markets
MARKET_DATA_PROVIDER=mock

# ─── Alpaca (only required when MARKET_DATA_PROVIDER=alpaca) ───────────────
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_SYMBOLS=AAPL,MSFT,TSLA

# ─── Frontend ──────────────────────────────────────────────────────────────
# Vite picks this up automatically during `npm run dev` and build
# For production, set this to your deployed backend URL
VITE_API_URL=http://localhost:8000
